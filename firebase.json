{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      ".gitignore",
      "plan.auth.md",
      "*.sh",
      ".git/**",
      ".claude/**",
      ".firebase/**",
      ".DS_Store",
      "node_modules/**",
      "**/*.md",
      "race_mockup.html",
      "race_proto.html",
      "APP_SPEC.md",
      "plan.auth.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
